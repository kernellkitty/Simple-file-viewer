<Window x:Class="skebobus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:skebobus"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Height="58">
                <Label Content="Way to the directory:"/>
                <TextBox x:Name="f_path" Width="492" Margin="0,10,0,10"/>
                <Button x:Name="b_scan" Content="Show" Width="147" Margin="10,10,0,10" Click="b_scan_Click"/>
            </StackPanel>
            <TreeView x:Name="tree" Height="364">
                
            </TreeView>
        </StackPanel>
    </Grid>
</Window>
